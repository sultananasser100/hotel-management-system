# Copy this file to .env and fill in the values. Never commit .env.
# All variables are server-side only. Never add a NEXT_PUBLIC_ prefix to any of them.

# PostgreSQL connection string. This value matches the local Docker database in
# docker-compose.yml. In production, set it to the hosted database's connection string
# in the hosting provider's environment settings instead.
DATABASE_URL="postgresql://hotel:hotel_dev_password@localhost:5432/hotel_management"

# Signs and encrypts Auth.js session tokens. Generate a random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google Gemini API key for the AI assistant (https://aistudio.google.com/apikey).
# Without it, the rest of the app works and the assistant reports that it isn't configured.
GEMINI_API_KEY=""

# Gemini model id. Optional; defaults to gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"
