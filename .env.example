# Copy this file to .env and fill in real values. Never commit .env.

# All of these are read server-side only. Never add a NEXT_PUBLIC_ prefix to any of them —
# that would expose the value to the browser.

# --- Database (Phase 2) ---
# Matches the credentials in docker-compose.yml for local dev. In production this points at the
# hosted PostgreSQL database instead (configured in the hosting provider, not in a committed file).
DATABASE_URL="postgresql://hotel:hotel_dev_password@localhost:5432/hotel_management"

# --- Auth (Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (`npx auth secret` resolves to an unrelated npm package, not Auth.js — see docs/DECISIONS.md)
AUTH_SECRET=""

# --- AI Assistant (Phase 14) ---
# Get a free-tier key from Google AI Studio: https://aistudio.google.com/apikey
# gemini-3.7-flash saw frequent 503 "model overloaded" errors on the free
# tier during testing; gemini-3.5-flash was more reliable. The "-flash-lite"
# variants (e.g. gemini-3.1-flash-lite) tested even more reliably still, if
# this one starts getting congested too.
# Without GEMINI_API_KEY the rest of the app works normally; the assistant just reports that it
# isn't configured. GEMINI_MODEL is optional — if unset, src/lib/assistant/client.ts falls back to
# the same default as below.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
