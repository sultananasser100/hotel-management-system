# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Phase 2) ---
# Matches the credentials in docker-compose.yml for local dev.
DATABASE_URL="postgresql://hotel:hotel_dev_password@localhost:5432/hotel_management"

# --- Auth (Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (`npx auth secret` resolves to an unrelated npm package, not Auth.js — see docs/DECISIONS.md)
AUTH_SECRET=""

# --- AI Assistant (Phase 14) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
